{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/inscricoes/ilha-open-2026-teste", "destination": "/inscricoes/ilha-open-2026", "permanent": false },
    { "source": "/torneios/ilha-open-2026-teste", "destination": "/torneios/ilha-open-2026", "permanent": false },
    { "source": "/clientes", "destination": "/", "permanent": true },
    { "source": "/clientes/:path*", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/cliente", "destination": "/", "permanent": true },
    { "source": "/alunos", "destination": "/", "permanent": true },
    { "source": "/agenda", "destination": "/quadras", "permanent": true },
    { "source": "/admin", "destination": "/adm", "permanent": false }
  ],
  "rewrites": [
    { "source": "/inscricoes/:slug", "destination": "/torneios" },
    { "source": "/inscricoes/:slug/:path*", "destination": "/torneios" },
    { "source": "/torneios", "destination": "/torneios" },
    { "source": "/torneios/:slug", "destination": "/torneios" },
    { "source": "/torneios/:slug/:path*", "destination": "/torneios" },
    { "source": "/cardapio", "destination": "/menu/" },
    { "source": "/quadras", "destination": "/" },
    { "source": "/menu", "destination": "/menu/index.html" },
    { "source": "/admbar", "destination": "/adm" },
    { "source": "/admbar/:path*", "destination": "/adm" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/auto-update.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/app-version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/adm",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/admbar",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/bar",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/menu",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/torneios",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/quadras",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
